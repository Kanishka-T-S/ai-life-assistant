# Flask Secret Key for session signing
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# SQLite Database filename / path
DATABASE_PATH=assistant.db

# Google Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
# If left empty, the application runs in Demo Mode with smart deterministic responses.
GEMINI_API_KEY=

# Supported Gemini model (e.g., gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini request timeout in seconds (default: 15)
GEMINI_TIMEOUT_SECONDS=15

# Flask Environment configuration
FLASK_ENV=development
FLASK_DEBUG=1
